@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set_and_check(PYNCPP_DIR "@PACKAGE_PYNCPP_DIR@")

find_dependency(PYNCPP REQUIRED COMPONENTS Qt5)

set(medInria_python_FOUND TRUE)
check_required_components(medInria_python)
